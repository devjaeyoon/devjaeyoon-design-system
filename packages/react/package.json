    "pack:check": "node ./scripts/check-ssr.mjs && node ../../scripts/check-package.mjs"
  },
  "peerDependencies": {
    "@devjaeyoon-design-system/css": ">=0.0.0 <1.0.0",
    "react": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@devjaeyoon-design-system/css": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }

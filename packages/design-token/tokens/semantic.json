{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "space": {
    "layout": {
      "gutter": {
        "$type": "dimension",
        "$value": "{space.4}",
        "$description": "Default horizontal layout gutter."
      },
      "section-sm": {
        "$type": "dimension",
        "$value": "{space.8}",
        "$description": "Section spacing for sm layouts."
      },
      "section-md": {
        "$type": "dimension",
        "$value": "{space.12}",
        "$description": "Section spacing for md layouts."
      },
      "section-lg": {
        "$type": "dimension",
        "$value": "{space.16}",
        "$description": "Section spacing for lg layouts."
      }
    },
    "content": {
      "stack": {
        "sm": {
          "$type": "dimension",
          "$value": "{space.2}",
          "$description": "Content stack spacing for sm density."
        },
        "md": {
          "$type": "dimension",
          "$value": "{space.4}",
          "$description": "Content stack spacing for md density."
        },
        "lg": {
          "$type": "dimension",
          "$value": "{space.6}",
          "$description": "Content stack spacing for lg density."
        }
      }
    }
  },
